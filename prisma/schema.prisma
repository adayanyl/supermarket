// Modelo de dados do app "Dispensa" — compras (NFC-e), estoque e lista mensal.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---- Contas, equipes e acesso ---------------------------------------------
// Cada usuário entra com usuário (ou qualquer um dos seus emails) + senha.
// Os dados da dispensa pertencem a uma equipe (ex.: a casa), compartilhada
// entre os membros. Um usuário pode estar em várias equipes.

model User {
  id           String   @id @default(cuid())
  username     String   @unique // sempre minúsculo (normalizeUsername)
  name         String
  passwordHash String // scrypt$N$r$p$salt$hash (domain/password.ts)

  emails      UserEmail[]
  memberships TeamMember[]
  sessions    Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Um usuário pode ter vários emails; qualquer um serve para entrar.
model UserEmail {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  email     String   @unique // sempre minúsculo (normalizeEmail)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Team {
  id   String @id @default(cuid())
  name String

  members       TeamMember[]
  invites       TeamInvite[]
  products      Product[]
  purchases     Purchase[]
  shoppingLists ShoppingList[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      String   @default("member") // "owner" | "member" (SQLite: sem enum)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// Convite por link: o dono gera um link (opcionalmente para um email) e envia
// para a pessoa. Quem abrir o link logado entra na equipe.
model TeamInvite {
  id          String    @id @default(cuid())
  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  email       String? // para quem é (informativo)
  token       String    @unique
  createdById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  acceptedBy  String?
  createdAt   DateTime  @default(now())

  @@index([teamId])
}

model Session {
  id           String   @id @default(cuid())
  tokenHash    String   @unique // sha256 do token do cookie
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  activeTeamId String? // equipe em uso nesta sessão
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ---- Catálogo ------------------------------------------------------------

model Product {
  id             String  @id @default(cuid())
  name           String // nome canônico, editável
  normalizedName String // forma normalizada (sem acento/caixa) para matching
  ean            String? // código de barras, quando houver (único por equipe)
  unit           String  @default("UN") // UN, KG, L, PCT...
  category       String?

  aliases       ProductAlias[]
  purchaseItems PurchaseItem[]
  movements     StockMovement[]
  listItems     ShoppingListItem[]

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, ean])
  @@index([teamId, normalizedName])
}

// Cada descrição/EAN já visto num cupom, mapeado para o produto canônico.
// É o que faz o matching melhorar sozinho a cada importação.
model ProductAlias {
  id             String   @id @default(cuid())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId      String
  rawDescription String // texto cru como apareceu no cupom
  normalizedText String // normalize(rawDescription)
  ean            String?
  source         String   @default("import") // "import" | "manual" | "merge"
  confidence     Float    @default(1) // 1 = confirmado pelo usuário; <1 = fuzzy/auto
  createdAt      DateTime @default(now())

  @@index([normalizedText])
  @@index([ean])
  @@index([productId])
}

// ---- Compras (cupom) -----------------------------------------------------

model Store {
  id        String     @id @default(cuid())
  cnpj      String     @unique
  name      String?
  uf        String?
  city      String?
  purchases Purchase[]
}

model Purchase {
  id           String   @id @default(cuid())
  accessKey    String? // chave de acesso (44 dígitos) — dedup por equipe
  purchasedAt  DateTime // data do cupom (fallback: momento do scan)
  totalValue   Float?
  importStatus String   @default("manual") // "auto" | "partial" | "manual"
  sefazUrl     String?
  uf           String?
  rawHtml      String? // cache opcional do HTML raspado (debug/reparse)

  store   Store?  @relation(fields: [storeId], references: [id])
  storeId String?

  items PurchaseItem[]

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teamId, accessKey])
  @@index([teamId, purchasedAt])
}

model PurchaseItem {
  id             String   @id @default(cuid())
  purchase       Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId     String
  rawDescription String // descrição original do cupom (mantida mesmo após match)
  ean            String?
  quantity       Float
  unit           String   @default("UN")
  unitPrice      Float // valor por unidade
  totalPrice     Float // total da linha

  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  movement StockMovement? // a movimentação IN gerada por esta linha

  @@index([productId])
}

// ---- Movimentações de estoque (fonte da verdade do saldo) ----------------

model StockMovement {
  id         String   @id @default(cuid())
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  type       String // "IN" | "OUT" (SQLite não suporta enum no Prisma)
  quantity   Float // sempre positivo; o sinal vem de `type`
  unit       String   @default("UN")
  occurredAt DateTime // quando a movimentação ocorreu
  reason     String? // "purchase" | "consumption" | "adjustment" | "loss" | livre

  purchaseItem   PurchaseItem? @relation(fields: [purchaseItemId], references: [id])
  purchaseItemId String?       @unique

  createdAt DateTime @default(now())

  @@index([productId, occurredAt])
  @@index([type, occurredAt])
}

// ---- Lista de compras ----------------------------------------------------

model ShoppingList {
  id          String             @id @default(cuid())
  periodMonth DateTime // 1º dia do mês alvo (local)
  status      String             @default("draft") // "draft" | "active" | "done"
  items       ShoppingListItem[]
  team        Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  createdAt   DateTime           @default(now())

  @@unique([teamId, periodMonth])
}

model ShoppingListItem {
  id                String       @id @default(cuid())
  list              ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)
  listId            String
  product           Product?     @relation(fields: [productId], references: [id])
  productId         String?
  customName        String? // rótulo livre para itens manuais sem produto
  origin            String       @default("auto") // "auto" | "manual"
  included          Boolean      @default(true) // usuário pode desmarcar item auto
  checked           Boolean      @default(false) // marcado como comprado
  suggestedQuantity Float? // da média de 6 meses (menos estoque, se ligado)
  unit              String       @default("UN")
  lastUnitPrice     Float? // preço na compra mais recente
  lastPurchaseDate  DateTime?

  @@index([listId])
  @@index([productId])
}
