# --- Desenvolvimento local (SQLite em arquivo) ---
# Usado pelo Prisma CLI (migrations/seed) e como fallback do runtime.
DATABASE_URL="file:./dev.db"

# --- Produção (Turso / libSQL) ---
# Defina estas duas na Vercel (e localmente se quiser apontar para o Turso).
# O runtime usa TURSO_DATABASE_URL quando presente.
# TURSO_DATABASE_URL="libsql://SEU-BANCO.turso.io"
# TURSO_AUTH_TOKEN="seu-token"
